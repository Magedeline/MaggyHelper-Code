// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/dotnet:2-8.0",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"mounts": [
		"source=nuget-cache,target=/home/vscode/.nuget/packages,type=volume"
	],
	"features": {
		"ghcr.io/devcontainers/features/dotnet:2": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/nikiforovall/devcontainer-features/dotnet-csharpier:1": {},
		"ghcr.io/daniellindemann/dev-container-features/dotnet-usersecrets-persistence:0": {}
	},
	"postCreateCommand": "dotnet restore Source/MaggyHelper.csproj",
	"customizations": {
		"vscode": {
			"settings": {
				"dotnet.defaultSolution": "MaggyHelper.sln",
				"editor.formatOnSave": true
			},
			"extensions": [
				"github.vscode-github-actions",
				"ms-dotnettools.csharp",
				"ms-dotnettools.csdevkit",
				"EditorConfig.EditorConfig"
			]
		}
	},
	"remoteUser": "vscode"

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [5000, 5001],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "dotnet restore",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
